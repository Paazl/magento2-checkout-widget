<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mm_paazl_order" engine="innodb" resource="sales" comment="Paazl Order Table">
        <column name="entity_id" xsi:type="int" identity="true" unsigned="true" nullable="false" comment="Entity ID"/>
        <column name="order_id" xsi:type="int" padding="10" unsigned="true" nullable="false" comment="Magento Order Id"/>
        <column name="ext_shipping_info" xsi:type="text" nullable="true" comment="Customer selection of the Paazl delivery"/>
        <column name="ext_sent_at" xsi:type="datetime" nullable="true" comment="When order has been synced with Paazl"/>
        <column name="invalid" xsi:type="smallint" nullable="true" comment="Invalid"/>
        <constraint referenceId="PRIMARY" xsi:type="primary">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="MM_PAAZL_ORDER_SENT_AT" indexType="btree">
            <column name="ext_sent_at"/>
        </index>
        <constraint referenceId="MM_PAAZL_ORDER_ORDER_ID" xsi:type="unique">
            <column name="order_id"/>
        </constraint>
        <constraint referenceId="MM_PAAZL_ORDER_ORDER_ID_SALES_ORDER_ENTITY_ID" xsi:type="foreign" table="mm_paazl_order" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="mm_paazl_quote" engine="innodb" resource="sales" comment="Paazl Quote Table">
        <column name="entity_id" xsi:type="int" identity="true" unsigned="true" nullable="false" comment="Entity ID"/>
        <column name="quote_id" xsi:type="int" padding="10" unsigned="true" nullable="false" comment="Quote Id"/>
        <column name="ext_shipping_info" xsi:type="text" nullable="true" comment="Shipping information"/>
        <column name="token" xsi:type="varchar" length="255" nullable="true" comment="Token"/>
        <column name="token_expires_at" xsi:type="datetime" nullable="true" comment="Token expires at"/>
        <constraint referenceId="PRIMARY" xsi:type="primary">
            <column name="entity_id"/>
        </constraint>
        <constraint referenceId="MM_PAAZL_QUOTE_QUOTE_ID" xsi:type="unique">
            <column name="quote_id"/>
        </constraint>
        <constraint referenceId="MM_PAAZL_QUOTE_QUOTE_ID_QUOTE_ENTITY_ID" xsi:type="foreign" table="mm_paazl_quote" column="quote_id" referenceTable="quote" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="mm_paazl_checkout_selection" engine="innodb" resource="sales" comment="Paazl Checkout Selections Table">
        <column name="entity_id" xsi:type="int" identity="true" unsigned="true" nullable="false" comment="Entity ID"/>
        <column name="quote_id" xsi:type="int" padding="10" unsigned="true" nullable="false" comment="Quote Id"/>
        <column name="ext_shipping_info" xsi:type="text" nullable="true" comment="Shipping information"/>
        <column name="was_sent" xsi:type="smallint" unsigned="true" nullable="false" default="0" comment="Was sent to external endpoint"/>
        <column name="sent_at" xsi:type="datetime" nullable="true" comment="When the selection was sent to external endpoint"/>
        <column name="next_to_payment" xsi:type="smallint" unsigned="true" nullable="false" default="0" comment="Customer proceeded to payment step"/>
        <column name="is_final" xsi:type="smallint" unsigned="true" nullable="false" default="0" comment="Selection is final (e.g. order placed)"/>
        <column name="pickup_offered" xsi:type="smallint" unsigned="true" nullable="false" default="0" comment="Pickup locations were available for the customer's address"/>
        <column name="created_at" xsi:type="timestamp" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column name="updated_at" xsi:type="timestamp" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint referenceId="PRIMARY" xsi:type="primary">
            <column name="entity_id"/>
        </constraint>
        <constraint referenceId="MM_PAAZL_SELECTIONS_QUOTE_ID" xsi:type="unique">
            <column name="quote_id"/>
        </constraint>
        <constraint referenceId="MM_PAAZL_SELECTION_QUOTE_ID_QUOTE_ENTITY_ID" xsi:type="foreign" table="mm_paazl_checkout_selection" column="quote_id" referenceTable="quote" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MM_PAAZL_CHECKOUT_SELECTION_WAS_SENT" indexType="btree">
            <column name="was_sent"/>
        </index>
        <index referenceId="MM_PAAZL_CHECKOUT_SELECTION_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
        <index referenceId="MM_PAAZL_CHECKOUT_SELECTION_UPDATED_AT" indexType="btree">
            <column name="updated_at"/>
        </index>
        <index referenceId="MM_PAAZL_CHECKOUT_SELECTION_IS_FINAL" indexType="btree">
            <column name="is_final"/>
        </index>
    </table>

    <table name="mm_paazl_deferred_queue" engine="innodb" resource="sales" comment="Paazl Deferred Queue Table">
        <column name="entity_id" xsi:type="int" identity="true" unsigned="true" nullable="false" comment="Entity ID"/>
        <column name="order_id" xsi:type="int" padding="10" unsigned="true" nullable="false" comment="Order ID"/>
        <column name="customer_name" xsi:type="varchar" length="255" nullable="true" comment="Customer Name"/>
        <column name="scheduled_processing_date" xsi:type="datetime" nullable="true" comment="Scheduled Processing Date"/>
        <column name="deferred_status" xsi:type="varchar" length="50" nullable="true" comment="Deferred Status"/>
        <column name="created_at" xsi:type="timestamp" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column name="updated_at" xsi:type="timestamp" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint referenceId="PRIMARY" xsi:type="primary">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="MM_PAAZL_DEFERRED_QUEUE_SCHEDULED_PROCESSING_DATE" indexType="btree">
            <column name="scheduled_processing_date"/>
        </index>
        <index referenceId="MM_PAAZL_DEFERRED_QUEUE_DEFERRED_STATUS" indexType="btree">
            <column name="deferred_status"/>
        </index>
        <constraint referenceId="MM_PAAZL_DEFERRED_QUEUE_ORDER_ID_SALES_ORDER_ENTITY_ID" xsi:type="foreign" table="mm_paazl_deferred_queue" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
