<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/guest-carts/:cartId/paazl-check-shipping-option" method="GET">
        <service class="Paazl\CheckoutWidget\Api\Webapi\GuestCheckShippingOptionInterface" method="get"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <route url="/V1/carts/mine/paazl-check-shipping-option" method="GET">
        <service class="Paazl\CheckoutWidget\Api\Webapi\CheckShippingOptionInterface" method="get"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

    <route url="/V1/guest-carts/:cartId/paazl-mark-next-to-payment" method="POST">
        <service class="Paazl\CheckoutWidget\Api\Webapi\GuestMarkNextToPaymentInterface" method="execute"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <route url="/V1/carts/mine/paazl-mark-next-to-payment" method="POST">
        <service class="Paazl\CheckoutWidget\Api\Webapi\MarkNextToPaymentInterface" method="execute"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

    <route url="/V1/guest-carts/:cartId/paazl-mark-pickup-offered" method="POST">
        <service class="Paazl\CheckoutWidget\Api\Webapi\GuestMarkPickupOfferedInterface" method="execute"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <route url="/V1/carts/mine/paazl-mark-pickup-offered" method="POST">
        <service class="Paazl\CheckoutWidget\Api\Webapi\MarkPickupOfferedInterface" method="execute"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

</routes>
